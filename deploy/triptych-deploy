#!/bin/bash
# Login shell for the `deploy` user on marvin (see deploy/README.md). Tailscale SSH runs
# `<shell> -c "<command>"`; the only command accepted is the 40-hex SHA of a commit on main.
# The checkout lives in /srv/triptych next to its (untracked) .env, which sets COMPOSE_FILE.
set -euo pipefail

sha=${!#}
if [[ ! $sha =~ ^[0-9a-f]{40}$ ]]; then
  echo "usage: tailscale ssh deploy@marvin <commit sha on main>" >&2
  exit 2
fi

# docker-rollout (https://github.com/wowu/docker-rollout) swaps web without a gap; see deploy/README.md.
# Without the plugin, `docker rollout --version` prints Docker's own version and succeeds.
if ! docker rollout --version 2>/dev/null | grep -q '^docker-rollout '; then
  echo "docker rollout is not installed (deploy/README.md → One-time setup → marvin)" >&2
  exit 1
fi

cd /srv/triptych
git fetch --quiet origin main
if ! git merge-base --is-ancestor "$sha" origin/main; then
  echo "$sha is not on main" >&2
  exit 1
fi
git checkout --quiet --detach "$sha"

export TRIPTYCH_IMAGE=ghcr.io/hatstand/triptych:$sha
docker compose pull --quiet
# A `docker compose` run by hand here has no TRIPTYCH_IMAGE, so it falls back to the local
# `triptych-app` image, which would otherwise be whatever was last built on marvin. Make that the
# deployed image too, so a hand-run `up` recreates containers on the same code.
docker tag "$TRIPTYCH_IMAGE" triptych-app

# Everything but web is simply recreated: migrations run first (the app services wait on them),
# and the worker force-re-registers with Restate on start, which retries invocations while it's
# away. `up` with no service names would recreate web too, stopping the old container before the
# new one is up.
not_web=$(docker compose config --services | grep -vx web)
# proxy (and cloudflared, which depends on it) wait until after the rollout: the first deploy with
# proxy can only take :8000 once the old web, which published it, is gone.
# shellcheck disable=SC2086  # one word per service
docker compose up --detach --no-build $(grep -vx -e proxy -e cloudflared <<<"$not_web")

# Start a second web on the new image, wait for its healthcheck, then stop the old one. proxy
# sends requests to whichever answers, so nothing is refused in between. Old and new code share
# the database for that moment, which is why migrations must stay backward-compatible.
docker rollout web

# shellcheck disable=SC2086
docker compose up --detach --no-build --remove-orphans $not_web
docker compose ps
