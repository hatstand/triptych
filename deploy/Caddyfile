# Public front door for Triptych (compose/public.yaml). Everything goes to the web app; /admin and
# the Restate UI are only ever on the tailnet (deploy/README.md).
{
	# The router forwards 443 only, so there is no :80 to redirect from or answer HTTP-01 on.
	auto_https disable_redirects
	servers {
		# No HTTP/3: UDP 443 isn't forwarded, so don't advertise it.
		protocols h1 h2
		timeouts {
			read_header 10s
		}
	}
}

{$PUBLIC_HOST} {
	tls {
		issuer acme {
			disable_http_challenge
		}
	}

	# Served by a separate app on a Unix socket behind `tailscale serve`. The web app has no
	# /admin route either; this just keeps it that way if one ever appears.
	@admin path /admin /admin/*
	respond @admin 404

	# Uploads are 15 MB a file and a drop can carry several; mail to /inbound is up to 25 MB.
	request_body {
		max_size 64MB
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	# Not the live-update stream: compressing it would hold events back until a buffer fills.
	@compressible not path /events
	encode @compressible zstd gzip

	reverse_proxy web:8000
}
