# Copy to .env. Used by both `docker compose` and the Tiltfile.

# Which compose files plain `docker compose up` should use (Tilt ignores this and uses --llm).
#   Strix Halo / ROCm:  compose.yaml:compose/ollama.yaml:compose/gpu-rocm.yaml
#   AMD Vulkan:         compose.yaml:compose/ollama.yaml:compose/gpu-vulkan.yaml
#   NVIDIA:             compose.yaml:compose/ollama.yaml:compose/gpu-nvidia.yaml
#   Host Ollama:        compose.yaml:compose/host-llm.yaml
COMPOSE_FILE=compose.yaml:compose/ollama.yaml:compose/gpu-rocm.yaml
# Serving the UI on the internet (a Cloudflare Tunnel; deploy/README.md → "Public access"): append
# :compose/public.yaml, and set TUNNEL_TOKEN and SECRET_KEY.
# TUNNEL_TOKEN=

# Gemma 4 26B-A4B (MoE, ~4B active params) QAT: ~16 GB, fast on Strix Halo memory bandwidth.
# On a box with less free memory use gemma4:e4b-it-qat (~6 GB).
LLM_MODEL=gemma4:26b-a4b-it-qat
LLM_NUM_CTX=16384
# A candidate model to try on every new ingest alongside LLM_MODEL. Its output is recorded and shown
# on /admin as a diff, never applied. Needs originals kept (INPUTS_*) and the model pulled.
# SHADOW_MODEL=
# Concurrent generations allowed by the Restate `gpu` flow-control rule (and OLLAMA_NUM_PARALLEL).
LLM_CONCURRENCY=1

# Where model weights live. Default is a named docker volume; a host path survives `down -v`.
# OLLAMA_MODELS_DIR=/more/ollama-models

# Exactly what the browser's address bar shows: passkeys only work from this origin.
PUBLIC_BASE_URL=http://localhost:8000
# Passkey RP ID; defaults to PUBLIC_BASE_URL's hostname. Set a parent domain if the UI may move
# between its subdomains: changing it later invalidates every passkey. (Not ts.net: public suffix.)
# WEBAUTHN_RP_ID=
# Extra origins (comma-separated) the UI is served from, besides PUBLIC_BASE_URL's.
# WEBAUTHN_ORIGINS=
# Signs passkey ceremony state and calendar feed URLs (changing it changes every feed URL).
# Generate: python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
SECRET_KEY=
# Interface for published host ports. 127.0.0.1 keeps everything local; set your tailnet IP to
# reach the UI from other devices.
# BIND_ADDR=127.0.0.1
# Address for just the Restate admin API + UI (:9070), defaulting to BIND_ADDR. Set marvin's
# Tailscale IP (`tailscale ip -4`) to reach the UI from the tailnet while everything else stays on
# loopback. The admin API has no auth: anyone who can reach it can invoke, cancel and purge.
# RESTATE_ADMIN_BIND=
# Where a browser reaches the Restate UI, linked from the admin page; e.g. after
# `tailscale serve --bg --https=9070 127.0.0.1:9070` on marvin: https://marvin.<tailnet>.ts.net:9070
# RESTATE_UI_URL=

# Real email via Cloudflare Email Routing → Worker → Tailscale Funnel → POST /inbound.
# Token is shared with the Worker (`npx wrangler secret put INBOUND_TOKEN`); unset disables /inbound.
# Generate: python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
INBOUND_TOKEN=
# Mail is accepted only from users' verified sender addresses (account page), not an allowlist.
# INBOUND_ADDRESS=plans@triptych.purplehatstands.com

# Admin pages at /admin, authorised by Tailscale identity (deploy/README.md → "Admin pages").
# COMPOSE_PROFILES=admin
# ADMIN_TAILSCALE_LOGINS=john.maguire@gmail.com
# ADMIN_SOCKET_DIR=./run
# Origin the admin pages are served from, if not PUBLIC_BASE_URL's (once the UI is public, the
# admin pages stay on the tailnet name): https://triptych.<tailnet>.ts.net
# ADMIN_ORIGINS=

# Logs are JSON lines on stdout; `text` for plain lines (Tilt's default). README → "Logs".
# LOG_FORMAT=json
# LOG_LEVEL=INFO

# Postgres (compose). Only read when Postgres creates its volume; for an existing one, change the
# role's password too (`\password triptych` in psql).
# POSTGRES_PASSWORD=triptych

# Originals (every email, upload and paste) are kept for reprocessing in a private R2 bucket,
# encrypted with per-user keys (src/triptych/inputs.py). Unset INPUTS_BUCKET = not kept.
# Token: an R2 API token with Object Read & Write on this bucket (and EVALS_BUCKET's) only.
# INPUTS_BUCKET=triptych-inputs
# INPUTS_ENDPOINT_URL=https://<account id>.r2.cloudflarestorage.com
# INPUTS_ACCESS_KEY_ID=
# INPUTS_SECRET_ACCESS_KEY=
# The master keyset encrypts every user's keys: losing it loses every original, so keep a copy
# off the box (a password manager). Generate: uv run python -m triptych.inputs new-master-keyset
# INPUTS_MASTER_KEYSET='{"primaryKeyId": ...}'
# Opted-in accounts' originals are copied, decrypted, to this bucket for the extraction eval set
# (src/triptych/evalset.py), using the INPUTS_* token, which must reach it too. Unset = not offered.
# EVALS_BUCKET=triptych-evals
