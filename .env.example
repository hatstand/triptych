# Copy to .env. Used by both `docker compose` and the Tiltfile.

# Which compose files plain `docker compose up` should use (Tilt ignores this and uses --llm).
#   Strix Halo / ROCm:  compose.yaml:compose/ollama.yaml:compose/gpu-rocm.yaml
#   AMD Vulkan:         compose.yaml:compose/ollama.yaml:compose/gpu-vulkan.yaml
#   NVIDIA:             compose.yaml:compose/ollama.yaml:compose/gpu-nvidia.yaml
#   Host Ollama:        compose.yaml:compose/host-llm.yaml
COMPOSE_FILE=compose.yaml:compose/ollama.yaml:compose/gpu-rocm.yaml

# Gemma 4 26B-A4B (MoE, ~4B active params) QAT: ~16 GB, fast on Strix Halo memory bandwidth.
# On a box with less free memory use gemma4:e4b-it-qat (~6 GB).
LLM_MODEL=gemma4:26b-a4b-it-qat
LLM_NUM_CTX=16384
# Concurrent generations allowed by the Restate `gpu` flow-control rule (and OLLAMA_NUM_PARALLEL).
LLM_CONCURRENCY=1

# Where model weights live. Default is a named docker volume; a host path survives `down -v`.
# OLLAMA_MODELS_DIR=/more/ollama-models

# Exactly what the browser's address bar shows: passkeys only work from this origin.
PUBLIC_BASE_URL=http://localhost:8000
# Passkey RP ID; defaults to PUBLIC_BASE_URL's hostname. Set a parent domain if the UI may move
# between its subdomains: changing it later invalidates every passkey. (Not ts.net: public suffix.)
# WEBAUTHN_RP_ID=
# Extra origins (comma-separated) the UI is served from, besides PUBLIC_BASE_URL's.
# WEBAUTHN_ORIGINS=
SECRET_KEY=change-me
# Interface for published host ports. 127.0.0.1 keeps everything local; set your tailnet IP to
# reach the UI from other devices (Funnel only ever exposes /inbound).
# BIND_ADDR=127.0.0.1
# Address for just the Restate admin API + UI (:9070), defaulting to BIND_ADDR. Set marvin's
# Tailscale IP (`tailscale ip -4`) to reach the UI from the tailnet while everything else stays on
# loopback. The admin API has no auth: anyone who can reach it can invoke, cancel and purge.
# RESTATE_ADMIN_BIND=

# Real email via Cloudflare Email Routing → Worker → Tailscale Funnel → POST /inbound.
# Token is shared with the Worker (`npx wrangler secret put INBOUND_TOKEN`); unset disables /inbound.
# Generate: python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
INBOUND_TOKEN=
INBOUND_ALLOWED_SENDERS=john.maguire@gmail.com

# Postgres (compose). Change before exposing anything.
# POSTGRES_PASSWORD=triptych
