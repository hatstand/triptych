{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "triptych-email",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  // Workers Logs plus Cloudflare's automatic OpenTelemetry tracing (handler, fetch to /inbound).
  // To send both to the same OTLP backend as the app, add it under Workers Observability →
  // Destinations in the dashboard and list its name in logs/traces "destinations".
  "observability": { "enabled": true, "traces": { "enabled": true } },
  "vars": {
    // Every address goes to marvin's public site. For per-machine test instances over Funnel, use
    // "https://{instance}.axolotl-goblin.ts.net/inbound": plans+<instance>@ then picks the machine,
    // and the template stays pinned to our tailnet so an address can't point the Worker elsewhere.
    "INBOUND_URL_TEMPLATE": "https://triptych.purplehatstands.com/inbound",
    "DEFAULT_INSTANCE": "marvin"
  },
  // Mail Triptych couldn't take (a deploy restarting it, marvin offline) waits here and is retried
  // from the queue with backoff (src/deliver.ts). Create both once: see README.md.
  "r2_buckets": [{ "binding": "PARKED", "bucket_name": "triptych-email-parked" }],
  "queues": {
    "producers": [{ "binding": "RETRIES", "queue": "triptych-email-retries" }],
    // Above MAX_ATTEMPTS in src/deliver.ts, so the Worker gives up (and logs it) before the queue does.
    "consumers": [{ "queue": "triptych-email-retries", "max_batch_size": 10, "max_retries": 30 }]
  }
  // Secret (not in source): `npx wrangler secret put INBOUND_TOKEN` — same value as INBOUND_TOKEN in ../../.env
}
