{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "triptych-email",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "observability": { "enabled": true },
  "vars": {
    // plans+<instance>@ → https://<instance>.<tailnet>/inbound (Funnel exposes only that path).
    // Pinned to our tailnet's domain so the recipient address can't point the Worker elsewhere.
    "INBOUND_URL_TEMPLATE": "https://{instance}.axolotl-goblin.ts.net/inbound",
    "DEFAULT_INSTANCE": "zem",
    // Verified Email Routing destination used when zem can't be reached, so mail is never lost.
    // A plus-address lets a Gmail filter skip it and avoid forwarding loops.
    "FALLBACK_ADDRESS": "john.maguire+triptych-undelivered@gmail.com"
  }
  // Secret (not in source): `npx wrangler secret put INBOUND_TOKEN` — same value as INBOUND_TOKEN in ../../.env
}
