{
  "name": "triptych-frontend",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "watch": "vite build --watch",
    "typecheck": "tsc",
    "lint": "biome lint .",
    "check:css": "cd ../src/triptych/web && biome check .",
    "format:css": "cd ../src/triptych/web && biome check --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  },
  "dependencies": {
    "htmx-ext-sse": "2.2.4",
    "htmx.org": "2.0.11"
  }
}
