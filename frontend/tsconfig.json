{
  "compilerOptions": {
    "target": "es2022",
    "module": "es2022",
    "lib": ["es2022", "dom", "dom.iterable"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    // Served as-is by FastAPI from /static (gitignored; built by the Dockerfile, or `npm run build`).
    "outDir": "../src/triptych/web/static/js",
    "rootDir": "src"
  },
  "include": ["src"]
}
